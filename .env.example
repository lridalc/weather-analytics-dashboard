# ============================================
# Weather Analytics Dashboard - Configuration
# ============================================

# --- API PROVIDER (REQUIRED) ---
# Get your free API key at https://openweathermap.org/api
# OpenWeatherMap free tier: 1,000 calls/day
API_KEY=your_api_key_here

# --- CACHING (OPTIONAL) ---
# Weather data cache TTL in seconds (5 minutes)
CACHE_TTL_WEATHER=300
# Geocoding data cache TTL in seconds (7 days)
CACHE_TTL_GEOCODING=604800
# Maximum number of entries in the cache
CACHE_MAX_SIZE=100

# --- RESILIENCY (OPTIONAL) ---
# Max retry attempts for transient HTTP failures
RETRY_MAX_ATTEMPTS=3
# Initial wait time between retries in seconds (exponential backoff)
RETRY_WAIT_SECONDS=1

# --- RATE LIMITING (OPTIONAL) ---
# Safety margin for OpenWeatherMap free tier (60 calls/min limit)
RATE_LIMIT_REQUESTS=55

# --- OBSERVABILITY (OPTIONAL) ---
# Environment (dev, test, prod)
ENVIRONMENT=dev
# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO