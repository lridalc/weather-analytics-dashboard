# ============================================
# Weather Analytics Dashboard - Configuration
# ============================================

# --- WEATHER API PROVIDER (REQUIRED) ---
# Get your free API key at https://openweathermap.org/api
# OpenWeatherMap free tier: 1,000 calls/day
WEATHER_API_KEY=your_api_key_here

# --- CACHING (OPTIONAL) ---
# Weather data cache TTL in seconds (default = 5 minutes) (0 to disable)
CACHE_TTL_WEATHER=300
# Geocoding data cache TTL in seconds (default = 7 days) (0 to disable)
CACHE_TTL_GEOCODING=604800
# Maximum number of entries in the cache (FIFO eviction) (default = 100) (minimum = 1)
CACHE_MAX_SIZE=100

# --- RESILIENCY (OPTIONAL) ---
# Max retry attempts for transient HTTP failures (default = 3) (0 to disable)
RETRY_MAX_ATTEMPTS=3
# Initial wait time between retries in seconds (exponential backoff) (default = 1) (0 for no delay)
RETRY_WAIT_SECONDS=1

# --- RATE LIMITING (OPTIONAL) ---
# Safety margin for OpenWeatherMap free tier (60 calls/min limit) (default = 55) (minimum = 1)
RATE_LIMIT_REQUESTS=55

# --- OBSERVABILITY (OPTIONAL) ---
# Environment (dev, test, prod) (default = dev)
ENVIRONMENT=dev
# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL) (default = INFO)
LOG_LEVEL=INFO