# ============================================
# Weather Analytics Dashboard - Configuration
# ============================================

# --- RATE LIMITING (OPTIONAL) ---
# Safety margin for Open-Meteo free tier (600 calls/min limit) (default = 250) (minimum = 1)
RATE_LIMIT_RPM=250  # Margin for geocoding requests

# --- CACHING (OPTIONAL) ---
# Weather data cache TTL in seconds (default = 5 minutes) (minimum = 0) (0 to disable)
CACHE_TTL_WEATHER=300
# Geocoding data cache TTL in seconds (default = 7 days) (minimum = 0) (0 to disable)
CACHE_TTL_GEOCODING=604800
# Maximum number of entries in the cache (FIFO eviction) (default = 100) (minimum = 1)
CACHE_MAX_SIZE=100

# --- RESILIENCY (OPTIONAL) ---
# Max time to wait for a single HTTP request/response in seconds (default = 10) (minimum = 0) (0 for no timeout)
REQUEST_TIMEOUT_SECONDS=10
# Max retry attempts for transient HTTP failures (default = 3) (minimum = 0) (0 to disable)
RETRY_MAX_ATTEMPTS=3
# Initial wait time between retries in seconds (exponential backoff) (default = 1) (minimum = 0) (0 for no delay)
RETRY_INITIAL_WAIT_SECONDS=1

# --- OBSERVABILITY (OPTIONAL) ---
# Environment (dev, test, prod) (default = dev)
ENVIRONMENT=dev
# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL) (default = INFO)
LOG_LEVEL=INFO
